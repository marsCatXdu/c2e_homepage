{
  "version": "2.0.0",
  "configurations": [
    {
      "command": "./node_modules/.bin/astro dev --host 127.0.0.1 --port 4321",
      "name": "Astro: Dev Server",
      "request": "launch",
      "type": "node-terminal",
      "serverReadyAction": {
        "pattern": "Local\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "killOnServerStop": true
      }
    },
    {
      "command": "./node_modules/.bin/astro dev --host 127.0.0.1 --port 4321",
      "name": "Astro: Dev Server (no browser)",
      "request": "launch",
      "type": "node-terminal"
    }
  ]
}
