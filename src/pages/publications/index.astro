---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PubList from '../../components/PubList.astro';
import { getCollection } from 'astro:content';

const publications = (await getCollection('publications'))
  .map((e) => e.data)
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
---

<BaseLayout
  title="Publications"
  description="Selected journal and conference publications from the C2E group."
>
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-teal">Publications</p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink md:text-5xl">Selected papers</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Sample entries across research fields. Extend the list in
      <code class="text-sm">src/content/publications/publications.yaml</code>.
    </p>
    <div class="mt-12">
      <PubList publications={publications} />
    </div>
  </div>
</BaseLayout>

<script>
  // Apply ?field= from research area links on the home page
  const params = new URLSearchParams(window.location.search);
  const field = params.get('field');
  if (field) {
    const select = document.querySelector('[data-filter-field]') as HTMLSelectElement | null;
    if (select && [...select.options].some((o) => o.value === field)) {
      select.value = field;
      select.dispatchEvent(new Event('change'));
    }
  }
</script>
