---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';
---

<BaseLayout title="Contact" description="Contact the C2E research group at HKUST.">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-teal">Contact</p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink md:text-5xl">Get in touch</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      You are always welcome to contact and visit us.
    </p>

    <div class="mt-14 grid gap-12 border-t border-line pt-12 md:grid-cols-2">
      <div>
        <h2 class="font-display text-xl font-semibold text-ink">Principal investigator</h2>
        <p class="mt-3 text-body">{site.pi.name}</p>
        <p class="text-sm text-muted">{site.pi.title}</p>
        <p class="mt-4">
          <a class="font-medium text-teal hover:underline" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl font-semibold text-ink">Affiliation</h2>
        <p class="mt-3 text-body">{site.name}</p>
        <p class="mt-1 text-muted">{site.affiliation}</p>
        <p class="mt-1 text-muted">The Hong Kong University of Science and Technology</p>
        <p class="mt-1 text-muted">Clear Water Bay, Kowloon, Hong Kong</p>
      </div>
    </div>
  </div>
</BaseLayout>
