---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const base = import.meta.env.BASE_URL;
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink text-white">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_70%_20%,rgba(20,145,155,0.35),transparent_55%),linear-gradient(160deg,#0b1c2c_0%,#123447_55%,#0d7377_140%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto flex min-h-[88vh] max-w-6xl flex-col justify-end px-5 pb-16 pt-28 md:px-8 md:pb-24">
      <p class="animate-[fade-in_0.8s_ease-out_both] font-display text-5xl font-semibold tracking-tight md:text-7xl">
        {site.shortName}
      </p>
      <h1
        class="mt-4 max-w-2xl animate-[fade-up_0.7s_ease-out_0.1s_both] font-display text-2xl font-medium leading-snug text-white/95 md:text-4xl"
      >
        {site.headline}
      </h1>
      <p
        class="mt-5 max-w-xl animate-[fade-up_0.7s_ease-out_0.2s_both] text-base leading-relaxed text-white/75 md:text-lg"
      >
        {site.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3 animate-[fade-up_0.7s_ease-out_0.3s_both]">
        <a
          href={`${base}people/`}
          class="rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-ink transition hover:bg-teal-muted"
        >
          Meet the team
        </a>
        <a
          href={`${base}contact/`}
          class="rounded-md border border-white/35 px-5 py-2.5 text-sm font-semibold text-white transition hover:border-white hover:bg-white/10"
        >
          Contact
        </a>
      </div>
      <p class="mt-10 text-sm text-white/55 animate-[fade-in_1s_ease-out_0.4s_both]">
        {site.tagline} · Led by {site.pi.name}
      </p>
    </div>
  </section>

  <!-- About -->
  <section class="border-b border-line bg-surface">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 md:grid-cols-[1fr_1.2fr] md:px-8">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-teal">About</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">
          From computer communications to energy systems
        </h2>
      </div>
      <div class="prose-c2e text-base text-body md:pt-8">
        <p>
          The research group of Computing, Communications, and Energy System Optimization (C2E) is led by
          {site.pi.name} at the {site.affiliation}.
        </p>
        <p>
          We use stochastic modeling, discrete optimization, and queueing theory to improve engineering systems —
          spanning cloud/edge computing, wireless communications, and smart grids. The name C2E also reflects our
          broadened scope: from computer communication systems to smart energy systems.
        </p>
      </div>
    </div>
  </section>

  <!-- Research areas -->
  <section class="bg-canvas">
    <div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.15em] text-teal">Research</p>
      <h2 class="mt-3 max-w-xl font-display text-3xl font-semibold text-ink md:text-4xl">
        Four focus areas
      </h2>
      <ul class="mt-12 grid list-none gap-x-10 gap-y-12 p-0 sm:grid-cols-2">
        {
          site.researchAreas.map((area, i) => (
            <li class="border-t border-line pt-6">
              <span class="text-xs font-medium text-muted">0{i + 1}</span>
              <h3 class="mt-2 font-display text-xl font-semibold text-ink">{area.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{area.summary}</p>
              <a
                href={`${base}publications/?field=${area.id}`}
                class="mt-4 inline-block text-sm font-medium text-teal hover:underline"
              >
                Related publications
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Recent news -->
  <section class="bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-teal">News</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">Recent updates</h2>
        </div>
        <a href={`${base}news/`} class="text-sm font-medium text-teal hover:underline">View all news</a>
      </div>
      <div class="mt-10">
        {
          news.map((item) => (
            <NewsCard
              title={item.data.title}
              date={item.data.date}
              summary={item.data.summary}
              href={`${base}news/${item.id}/`}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
