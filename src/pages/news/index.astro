---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="News" description="News and updates from the C2E research group.">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-teal">News</p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink md:text-5xl">Group updates</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Gatherings, visits, openings, and milestones from the C2E group.
    </p>
    <div class="mt-12">
      {
        news.map((item) => (
          <NewsCard
            title={item.data.title}
            date={item.data.date}
            summary={item.data.summary}
            href={`${base}news/${item.id}/`}
            image={item.data.image}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
