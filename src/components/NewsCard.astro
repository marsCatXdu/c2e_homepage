---
interface Props {
  title: string;
  date: Date;
  summary: string;
  href: string;
  image?: string;
  locale?: 'en' | 'zh-cn';
}

const { title, date, summary, href, image, locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
const formatted = date.toLocaleDateString(locale === 'zh-cn' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const imageSrc = image
  ? image.startsWith('http')
    ? image
    : `${base}${image.replace(/^\//, '')}`
  : undefined;
---

<article class="group border-b border-line py-6 last:border-b-0">
  <a href={href} class="flex flex-col gap-4 no-underline sm:flex-row sm:gap-6">
    {
      imageSrc && (
        <div class="shrink-0 overflow-hidden rounded-md bg-canvas sm:w-48">
          <img
            src={imageSrc}
            alt=""
            class="aspect-[4/3] h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
      )
    }
    <div class="min-w-0">
      <time class="text-xs font-medium uppercase tracking-wide text-teal" datetime={date.toISOString()}>
        {formatted}
      </time>
      <h3 class="mt-2 font-display text-xl font-semibold text-ink transition group-hover:text-teal">
        {title}
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-muted">{summary}</p>
    </div>
  </a>
</article>
