---
import site from '../data/site.json';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line bg-canvas">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 md:flex-row md:items-end md:justify-between md:px-8">
    <div>
      <p class="font-display text-xl font-semibold text-ink">{site.name}</p>
      <p class="mt-1 max-w-md text-sm text-muted">{site.affiliation}</p>
      <p class="mt-3 text-sm">
        <a class="text-teal hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <div class="flex flex-wrap gap-4 text-sm text-muted">
      <a href={`${base}people/`} class="hover:text-teal">People</a>
      <a href={`${base}publications/`} class="hover:text-teal">Publications</a>
      <a href={`${base}contact/`} class="hover:text-teal">Contact</a>
    </div>
  </div>
  <div class="border-t border-line/70">
    <p class="mx-auto max-w-6xl px-5 py-4 text-xs text-muted md:px-8">
      © {year} {site.name}. Research group led by {site.pi.name}.
    </p>
  </div>
</footer>
