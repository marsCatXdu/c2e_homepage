---
import PubItem from './PubItem.astro';
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Pub {
  id: string;
  authors: string;
  title: string;
  venue: string;
  year: number;
  type: 'journal' | 'conference';
  fields: string[];
  url?: string;
}

interface Props {
  publications: Pub[];
  locale?: Locale;
}

const { publications, locale = 'en' } = Astro.props;

const fieldOptions = [
  { value: 'all', label: t(locale, 'pubs.allFields') },
  { value: 'smart-grids', label: t(locale, 'pubs.smartGrids') },
  { value: 'cloud-edge', label: t(locale, 'pubs.cloudEdge') },
  { value: 'wireless', label: t(locale, 'pubs.wireless') },
  { value: 'online-algorithms', label: t(locale, 'pubs.onlineAlgorithms') },
];

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const byYear = years.map((year) => ({
  year,
  items: publications.filter((p) => p.year === year),
}));
---

<div class="pub-filter" data-pub-filter>
  <div class="mb-8 flex flex-wrap gap-3">
    <label class="flex flex-col gap-1 text-xs font-medium uppercase tracking-wide text-muted">
      {t(locale, 'pubs.type')}
      <select
        data-filter-type
        class="rounded-md border border-line bg-surface px-3 py-2 text-sm font-medium normal-case tracking-normal text-ink"
      >
        <option value="all">{t(locale, 'pubs.allTypes')}</option>
        <option value="journal">{t(locale, 'pubs.journal')}</option>
        <option value="conference">{t(locale, 'pubs.conference')}</option>
      </select>
    </label>
    <label class="flex flex-col gap-1 text-xs font-medium uppercase tracking-wide text-muted">
      {t(locale, 'pubs.field')}
      <select
        data-filter-field
        class="rounded-md border border-line bg-surface px-3 py-2 text-sm font-medium normal-case tracking-normal text-ink"
      >
        {fieldOptions.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </label>
  </div>

  <p class="mb-4 text-sm text-muted">
    {t(locale, 'pubs.showing')} <span data-count>{publications.length}</span> {t(locale, 'pubs.of')}{' '}
    {publications.length} {t(locale, 'pubs.publications')}
  </p>

  <div data-pub-list>
    {
      byYear.map(({ year, items }) => (
        <section class="pub-year-group mt-14 first:mt-0" data-year-group={year}>
          <h2 class="pub-year-heading mb-2 border-b border-line pb-2 font-display text-2xl font-semibold text-ink">
            {year}
          </h2>
          <ul class="list-none p-0">
            {items.map((pub) => (
              <PubItem
                authors={pub.authors}
                title={pub.title}
                venue={pub.venue}
                year={pub.year}
                type={pub.type}
                fields={pub.fields}
                url={pub.url}
                locale={locale}
              />
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p data-empty class="hidden py-12 text-center text-muted">{t(locale, 'pubs.empty')}</p>
</div>

<script>
  function initPubFilter() {
    const root = document.querySelector('[data-pub-filter]');
    if (!root) return;

    const typeSelect = root.querySelector('[data-filter-type]') as HTMLSelectElement | null;
    const fieldSelect = root.querySelector('[data-filter-field]') as HTMLSelectElement | null;
    const items = Array.from(root.querySelectorAll('.pub-item')) as HTMLElement[];
    const groups = Array.from(root.querySelectorAll('[data-year-group]')) as HTMLElement[];
    const countEl = root.querySelector('[data-count]');
    const emptyEl = root.querySelector('[data-empty]');

    function apply() {
      const type = typeSelect?.value ?? 'all';
      const field = fieldSelect?.value ?? 'all';
      let visible = 0;

      for (const item of items) {
        const itemType = item.dataset.type ?? '';
        const itemFields = (item.dataset.fields ?? '').split(',');
        const typeOk = type === 'all' || itemType === type;
        const fieldOk = field === 'all' || itemFields.includes(field);
        const show = typeOk && fieldOk;
        item.hidden = !show;
        if (show) visible += 1;
      }

      for (const group of groups) {
        const anyVisible = Array.from(group.querySelectorAll('.pub-item')).some(
          (el) => !(el as HTMLElement).hidden,
        );
        group.hidden = !anyVisible;
      }

      if (countEl) countEl.textContent = String(visible);
      if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
    }

    typeSelect?.addEventListener('change', apply);
    fieldSelect?.addEventListener('change', apply);
    apply();
  }

  initPubFilter();
  document.addEventListener('astro:page-load', initPubFilter);
</script>
