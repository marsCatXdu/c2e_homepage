---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Props {
  authors: string;
  title: string;
  venue: string;
  year: number;
  type: string;
  fields: string[];
  url?: string;
  locale?: Locale;
}

const { authors, title, venue, year, type, fields, url, locale = 'en' } = Astro.props;

const fieldLabels: Record<string, string> = {
  'smart-grids': t(locale, 'pubs.smartGrids'),
  'cloud-edge': t(locale, 'pubs.cloudEdge'),
  wireless: t(locale, 'pubs.wireless'),
  'online-algorithms': t(locale, 'pubs.onlineAlgorithms'),
};

const typeLabel =
  type === 'journal' ? t(locale, 'pubs.journal') : type === 'conference' ? t(locale, 'pubs.conference') : type;

const doi =
  url && url.includes('doi.org/')
    ? url.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '')
    : undefined;
---

<li
  class="pub-item border-b border-line py-5"
  data-type={type}
  data-fields={fields.join(',')}
  data-year={year}
>
  <p class="text-sm text-muted">
    {authors}
  </p>
  <h3 class="mt-1 font-medium leading-snug text-ink">
    {
      url ? (
        <a href={url} class="pub-title-link" target="_blank" rel="noopener noreferrer">
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  <p class="mt-2 text-sm text-muted">
    <span class="italic">{venue}</span>, {year}
    {
      doi && (
        <>
          {' · '}
          <a href={url} class="pub-doi-link" target="_blank" rel="noopener noreferrer">
            {t(locale, 'pubs.doi')}
          </a>
        </>
      )
    }
    {
      url && !doi && (
        <>
          {' · '}
          <a href={url} class="pub-doi-link" target="_blank" rel="noopener noreferrer">
            {t(locale, 'pubs.link')}
          </a>
        </>
      )
    }
  </p>
  <div class="mt-2 flex flex-wrap gap-2">
    <span class="rounded bg-canvas px-2 py-0.5 text-xs font-medium text-muted">{typeLabel}</span>
    {
      fields.map((f) => (
        <span class="rounded bg-teal-muted px-2 py-0.5 text-xs font-medium text-teal">
          {fieldLabels[f] ?? f}
        </span>
      ))
    }
  </div>
</li>

<style>
  .pub-title-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .pub-title-link:hover,
  .pub-title-link:focus-visible {
    color: var(--color-teal);
    text-decoration-color: var(--color-teal);
  }

  .pub-doi-link {
    font-weight: 500;
    color: var(--color-teal);
    text-decoration: none;
  }

  .pub-doi-link:hover,
  .pub-doi-link:focus-visible {
    text-decoration: underline;
  }
</style>
