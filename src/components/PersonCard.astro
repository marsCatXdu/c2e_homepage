---
import { linkifyProfessorParts } from '../i18n/professors';

interface Props {
  name: string;
  nameZh?: string;
  title: string;
  email?: string;
  website?: string;
  photo?: string;
  compact?: boolean;
  locale?: 'en' | 'zh-cn';
  nameHref?: string;
}

const {
  name,
  nameZh,
  title,
  email,
  website,
  photo,
  compact = false,
  locale = 'en',
  nameHref,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const photoSrc = photo
  ? photo.startsWith('http')
    ? photo
    : `${base}${photo.replace(/^\//, '')}`
  : undefined;
const displayName = nameZh ? `${name}（${nameZh}）` : name;
const titleParts = linkifyProfessorParts(title, locale);
---

<article
  class:list={[
    'border-b border-line py-6 last:border-b-0',
    compact ? '' : 'sm:flex sm:gap-6',
  ]}
>
  {
    photoSrc && !compact && (
      <div class="mb-4 shrink-0 sm:mb-0">
        <img
          src={photoSrc}
          alt={`Photo of ${name}`}
          width="120"
          height="120"
          class="h-28 w-28 rounded-full object-cover bg-canvas"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      {
        photoSrc && compact && (
          <img
            src={photoSrc}
            alt=""
            width="40"
            height="40"
            class="h-10 w-10 rounded-full object-cover bg-canvas"
            loading="lazy"
          />
        )
      }
      <h3 class="font-display text-xl font-semibold text-ink">
        {
          nameHref ? (
            <a class="text-ink hover:text-teal hover:underline" href={nameHref} target="_blank" rel="noopener noreferrer">
              {displayName}
            </a>
          ) : (
            displayName
          )
        }
      </h3>
    </div>
    <p class="mt-1 text-sm font-medium text-muted">
      {
        titleParts.map((part) =>
          part.type === 'prof' ? (
            <a class="text-teal hover:underline" href={part.href} target="_blank" rel="noopener noreferrer">
              {part.value}
            </a>
          ) : (
            part.value
          ),
        )
      }
    </p>
    {
      !compact && (
        <div class="prose-c2e mt-3 text-sm text-body">
          <slot />
        </div>
      )
    }
    <div class="mt-3 flex flex-wrap gap-4 text-sm">
      {
        email && (
          <a class="text-teal hover:underline" href={`mailto:${email}`}>
            {email}
          </a>
        )
      }
      {
        website && (
          <a class="text-teal hover:underline" href={website} target="_blank" rel="noopener noreferrer">
            Website
          </a>
        )
      }
    </div>
  </div>
</article>
