---
interface Props {
  name: string;
  title: string;
  email?: string;
  website?: string;
  roleLabel?: string;
}

const { name, title, email, website, roleLabel } = Astro.props;
---

<article class="border-b border-line py-6 last:border-b-0">
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h3 class="font-display text-xl font-semibold text-ink">{name}</h3>
    {roleLabel && <span class="text-xs font-medium uppercase tracking-wide text-teal">{roleLabel}</span>}
  </div>
  <p class="mt-1 text-sm font-medium text-muted">{title}</p>
  <div class="prose-c2e mt-3 text-sm text-body">
    <slot />
  </div>
  <div class="mt-3 flex flex-wrap gap-4 text-sm">
    {
      email && (
        <a class="text-teal hover:underline" href={`mailto:${email}`}>
          {email}
        </a>
      )
    }
    {
      website && (
        <a class="text-teal hover:underline" href={website} target="_blank" rel="noopener noreferrer">
          Website
        </a>
      )
    }
  </div>
</article>
