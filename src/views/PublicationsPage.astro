---
import BaseLayout from '../layouts/BaseLayout.astro';
import PubList from '../components/PubList.astro';
import { getCollection } from 'astro:content';
import { getLocaleFromUrl, type Locale } from '../i18n/locales';
import { t } from '../i18n/ui';

const base = import.meta.env.BASE_URL;
const locale: Locale = Astro.currentLocale === 'zh-cn' ? 'zh-cn' : getLocaleFromUrl(Astro.url, base);

const publications = (await getCollection('publications'))
  .map((e) => e.data)
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
---

<BaseLayout title={t(locale, 'pubs.title')} description={t(locale, 'pubs.intro')}>
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-teal">{t(locale, 'pubs.eyebrow')}</p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink md:text-5xl">{t(locale, 'pubs.title')}</h1>
    <p class="mt-4 max-w-2xl text-muted">{t(locale, 'pubs.intro')}</p>
    <div class="mt-12">
      <PubList publications={publications} locale={locale} />
    </div>
  </div>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const field = params.get('field');
  if (field) {
    const select = document.querySelector('[data-filter-field]') as HTMLSelectElement | null;
    if (select && [...select.options].some((o) => o.value === field)) {
      select.value = field;
      select.dispatchEvent(new Event('change'));
    }
  }
</script>
